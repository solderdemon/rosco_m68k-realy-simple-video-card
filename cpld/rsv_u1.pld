Name     RSVBus;
PartNo   U1;
Date     2026-09-20;
Revision r3;
Designer SolderDemon m68k Really Simple Video;
Company  rosco_m68k;
Assembly SolderDemon m68k Really Simple Video r3;
Location U1;
Device   f1502ispplcc44;

/*
 * SolderDemon m68k Really Simple Video r3, U1 of 2: bus interface, byte counter, low address half.
 *
 * r3 splits the card across two ATF1502AS-10JU44 so that the four 74HCT157 address multiplexers
 * can move inside. The trick is to split the counters along with the multiplexer halves: U1 keeps
 * the byte counter and drives MA0..MA6, U2 keeps the line counter and drives MA7..MA16, so no
 * counter bit ever has to cross between the two chips. Only SEL, LEND and VBLANK do.
 *
 * Raster: 640 x 480 @ 60 Hz from a 25.000 MHz can on GCLK1. Everything is clocked by CLK25.
 *   byte time B 0..99 (8 clocks each): visible bytes 0..79 are shown during byte times 1..80,
 *     because the 74HC166 shows byte n during byte time n + 1
 *   clock in a line: visible 8..647, front porch 648..663, HSYNC 664..759, back porch 760..7
 * HSYNC_N and HBLANK are registers decoded from the byte before the one they describe, so the
 * register itself supplies the 74HC166's one-byte pipeline delay.
 *
 * MA0..MA6 is the low half of the SRAM address: the CPU's A7..A1 while the card is selected,
 * the byte counter otherwise. U2 does the same for MA7..MA16.
 *
 * Bus (rosco_m68k r2 expansion, /EXPSEL already contains /AS), window $A00000-$BFFFFF:
 *   $A00001 + 2n  VRAM byte n = page << 16 | y << 7 | x >> 3, byte access through /LDS only
 *   $B00001       write: b0 video on (here), b1 page shown (in U2); cleared by /RESET
 *                 read:  b0 VBLANK, b1 HBLANK; b2-b7 are not driven
 * A22 is not decoded and needs no pin: under /EXPSEL the only range with A23 & A21 set is
 * $A00000-$BFFFFF, because $E00000-$FFFFFF is outside the expansion window.
 * /DTACK is open-drain on the mainboard (1k2 pull-up): the card only ever pulls it low.
 *
 * The pin numbers below are also read by tools/build_card.py and tools/sim_card.py, so this file
 * is the single source of U1's pinout.
 */

PROPERTY ATMEL {JTAG = ON};
PROPERTY ATMEL {TDI_PULLUP = ON};
PROPERTY ATMEL {TMS_PULLUP = ON};
PROPERTY ATMEL {PREASSIGN = KEEP};

/* ---- dedicated input pins (these four cannot be outputs) ---- */
PIN 43 = CLK25;                     /* GCLK1, 25.000 MHz oscillator */
PIN 1  = RESET_N;                   /* GCLR */
PIN 2  = LDS_N;
PIN 44 = EXPSEL_N;

/* ---- low half of the SRAM address (left side, facing the SRAM) ---- */
PIN [4,5,6,8,9,11,12] = [MA0..6];

/* ---- CPU address bits that feed it (bottom side, facing the bus) ---- */
PIN [14,16,17,18,19,20,21] = [A1..7];

/* ---- bus control and status (right side) ---- */
PIN 24 = A23;
PIN 25 = A21;
PIN 26 = A20;
PIN 27 = RW;
PIN 28 = DTACK_N;
PIN 29 = D0;                        /* status b0 = VBLANK, and the data bit of "video on" */
PIN 31 = D1;                        /* status b1 = HBLANK */

/* ---- to U2, the SRAM, the 74HCT245, the 74HC166 and the VGA socket (top side) ---- */
PIN 33 = SEL_N;                     /* to U2: 0 = the CPU owns the SRAM address */
PIN 34 = LEND;                      /* to U2: step the line counter on the next edge */
PIN 36 = VBLANK;                    /* from U2 */
PIN 37 = SRAM_WE_N;
PIN 39 = BUF_OE_N;                  /* /OE of the 74HCT245 */
PIN 40 = LOAD_N;                    /* PE of the 74HC166 */
PIN 41 = HSYNC_N;

/* ---- buried nodes ---- */
PINNODE = [PH0..2];                 /* the eight pixel clocks of one byte */
PINNODE = [B0..6];                  /* byte counter */
PINNODE = HBLANK;
PINNODE = VIDEOON;
PINNODE = BUFD;

FIELD BYTE = [B6..0];

/* ---- pixel phase ------------------------------------------------------------------------ */

PH0.D = !PH0;
PH1.D = PH1 $ PH0;
PH2.D = PH2 $ (PH1 & PH0);

BEND  = PH2 & PH1 & PH0;            /* the last clock of a byte time */

/* ---- byte counter B = 0..99 --------------------------------------------------------------
 * 99 = 1100011 is the only reachable state with B6 & B5 & B1 & B0, so that is the whole wrap
 * decode; 100..127 cannot occur in normal operation and walk into it within four steps.
 */

BLAST = B6 & B5 & B1 & B0;
BCLR  = BEND & BLAST;

B0.D = (B0 $ BEND) & !BCLR;
B1.D = (B1 $ (BEND & B0)) & !BCLR;
B2.D = (B2 $ (BEND & B1 & B0)) & !BCLR;
B3.D = (B3 $ (BEND & B2 & B1 & B0)) & !BCLR;
B4.D = (B4 $ (BEND & B3 & B2 & B1 & B0)) & !BCLR;
B5.D = (B5 $ (BEND & B4 & B3 & B2 & B1 & B0)) & !BCLR;
B6.D = (B6 $ (BEND & B5 & B4 & B3 & B2 & B1 & B0)) & !BCLR;

/* Registered one clock ahead, so LEND is high for exactly the last clock of byte time 94 --
 * the end of the HSYNC pulse. U2 steps the line counter on the edge that ends it. */
LEND.D = PH2 & PH1 & !PH0 & BYTE:'d'94;

/* ---- sync and blanking --------------------------------------------------------------------
 * HBLANK covers byte times 80..99, which stops the load one byte early so that exactly bytes
 * 0..79 are fetched; HSYNC_N is low for byte times 83..94 = clocks 664..759.
 */

HBLANK.D  = (BEND & BYTE:['d'79..'d'98]) # (!BEND & HBLANK);
HSYNC_N.D = (BEND & !BYTE:['d'82..'d'93]) # (!BEND & HSYNC_N);

BLANK = HBLANK # VBLANK # !VIDEOON;

/* Low for exactly the last pixel clock of a byte, so the 74HC166 takes the SRAM byte on the
 * following edge. Held high while blanking: the 166 keeps shifting and its grounded serial
 * input walks zeros in, so the picture goes black within one byte and no real pixel ever
 * reaches a porch. */
LOAD_N.D = !(PH2 & PH1 & !PH0 & !BLANK);

/* ---- low half of the address multiplexer --------------------------------------------------
 * What used to be U5 and half of U6 in r1: MA0..MA6 = A7..A1 during a card cycle, the byte
 * counter otherwise. Two product terms each.
 */

MA0 = (SEL & A1) # (!SEL & B0);
MA1 = (SEL & A2) # (!SEL & B1);
MA2 = (SEL & A3) # (!SEL & B2);
MA3 = (SEL & A4) # (!SEL & B3);
MA4 = (SEL & A5) # (!SEL & B4);
MA5 = (SEL & A6) # (!SEL & B5);
MA6 = (SEL & A7) # (!SEL & B6);

/* ---- bus interface ------------------------------------------------------------------------ */

SEL   = !EXPSEL_N & A23 & A21;
SEL_N = !SEL;

SRAM_WE_N = !(SEL & !A20 & !RW & !LDS_N);

/* The SRAM's OE# is tied low on the board, so it drives MD whenever WE# is high. BUFD delays
 * the 74HCT245's enable by one CLK25 (40.0 ns) after /LDS falls, which is longer than the SRAM
 * needs to let go of MD once WE# is low; the trailing edge is not delayed, because BUF_OE_N
 * also ANDs the live /LDS. The two never drive MD at the same time. */
BUFD.D   = SEL & !A20 & !LDS_N;
BUF_OE_N = !(BUFD & SEL & !A20 & !LDS_N);

DTACK_N    = 'b'0;
DTACK_N.oe = SEL & !LDS_N;

/* Status read: b0 = VBLANK (from U2), b1 = HBLANK. b2..b7 are not driven. */
D0    = VBLANK;
D0.oe = SEL & A20 & RW & !LDS_N;
D1    = HBLANK;
D1.oe = SEL & A20 & RW & !LDS_N;

/* Control register b0 = video on. Sampled on every CLK25 edge while the write strobe is low, so
 * it does not depend on the 68010's data hold time after /LDS rises. U2 samples b1 the same way. */
REGWR = SEL & A20 & !RW & !LDS_N;
VIDEOON.D  = (REGWR & D0.io) # (!REGWR & VIDEOON);
VIDEOON.ar = !RESET_N;

[PH0..2].ck = CLK25;
[B0..6].ck = CLK25;
LEND.ck = CLK25;
HBLANK.ck = CLK25;
HSYNC_N.ck = CLK25;
LOAD_N.ck = CLK25;
BUFD.ck = CLK25;
VIDEOON.ck = CLK25;
